<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Deployed to Foundry as a hosted agent with bundled dependencies: the project references
    agents and tools outside this folder, so azd publishes it locally (`dotnet publish`) and
    uploads the publish output as-is. See azure.yaml.
  -->

  <PropertyGroup>
    <RootNamespace>IssueTriageWorkflow</RootNamespace>
    <AssemblyName>IssueTriageWorkflow</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="DotNetEnv" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../agents/IssueTriageAgent/IssueTriageAgent.csproj" />
    <ProjectReference Include="../../tools/GitHubTools/GitHubTools.csproj" />
  </ItemGroup>

</Project>
