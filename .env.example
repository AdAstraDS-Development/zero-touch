# Foundry project endpoint (shape: https://<account>.services.ai.azure.com/api/projects/<project>)
FOUNDRY_PROJECT_ENDPOINT=<your-foundry-project-endpoint>

# Model deployment name in your Foundry project.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o

# GitHub App used to read issues and source code and post comments
# (permissions: "Issues: Read and write", "Contents: Read-only").
# App ID (or client ID) from the app's settings page.
GITHUB_APP_ID=<app-id>

# API root: https://api.github.com/ or https://api.<subdomain>.ghe.com/ for Enterprise Cloud.
GITHUB_API_URL=https://api.github.com/

# The app's private key: either a path to the downloaded .pem file ...
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.private-key.pem
# ... or a Key Vault secret (read with your az login / the agent's managed identity) ...
# AZURE_KEY_VAULT_URI=https://<vault-name>.vault.azure.net/
# GITHUB_APP_PRIVATE_KEY_SECRET_NAME=github-app-private-key
# ... or the key itself (PEM with "\n" for newlines, or the base64-encoded .pem file).
# GITHUB_APP_PRIVATE_KEY=

# Optional: comma-separated allowlist, e.g. "my-org/my-repo,my-org/*". Empty = every repo the app is installed on.
GITHUB_ALLOWED_REPOS=

# Local development only: port Foundry probes / the local client uses.
ASPNETCORE_URLS=http://+:8088

# Local development only: use developer credentials (az login) and skip the managed identity probe.
AZURE_TOKEN_CREDENTIALS=dev
