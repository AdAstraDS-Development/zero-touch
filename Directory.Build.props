<Project>

  <!-- Shared settings for every C# project under /agents, /workflow and /tools. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Workflows are published into a local publish/ folder for deployment; keep it out of the build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
