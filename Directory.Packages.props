<Project>

  <!-- Central package versions, so agents and tools always use the same dependencies. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AgentFrameworkVersion>1.20.0-preview.260831.1</AgentFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Agents.AI.Foundry" Version="$(AgentFrameworkVersion)" />
    <PackageVersion Include="Microsoft.Agents.AI.Foundry.Hosting" Version="$(AgentFrameworkVersion)" />
    <!-- Stable release that Foundry.Hosting depends on. -->
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.20.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageVersion Include="Azure.AI.Projects" Version="3.0.0-beta.2" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <PackageVersion Include="DotNetEnv" Version="3.2.0" />
    <PackageVersion Include="Octokit" Version="14.0.0" />
  </ItemGroup>

</Project>
